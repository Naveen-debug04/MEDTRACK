NODE_ENV=development
PORT=4000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=medtrack
# Optional comma-separated DNS servers for Node SRV resolution (e.g. 1.1.1.1,8.8.8.8).
MONGODB_DNS_SERVERS=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SAME_SITE=lax
EXPIRY_ALERT_DAYS=30
# Optional OpenAI-compatible provider. Leave unset to use the local inventory assistant.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
